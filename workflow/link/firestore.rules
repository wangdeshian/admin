rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function allowed() {
   return request.auth != null &&
          request.auth.token.firebase.sign_in_provider == 'google.com' &&
          request.auth.token.email_verified == true &&
          request.auth.token.email is string &&
          exists(/databases/$(database)/documents/adminWorkflowMembers/$(request.auth.token.email));
  }
  function valid(nextRev) {
   let d = request.resource.data;
   return d.keys().hasOnly(['rev','payload','updatedAt','updatedBy']) &&
          d.rev is int && d.rev == nextRev &&
          d.payload is string && d.payload.size() <= 750000 &&
          d.updatedAt == request.time && d.updatedBy == request.auth.uid;
  }
  match /boards/administration {
   allow get: if allowed();
   allow create: if allowed() && valid(1);
   allow update: if allowed() && valid(resource.data.rev + 1);
  }
  // Media-free, link-scoped board. A console administrator creates or
  // revokes the document. Only a holder of its random ID can get or update it.
  match /workflowLinkBoards/{linkId} {
   function linkExists() {
    return linkId.matches('^[A-Za-z0-9_-]{43}$') && resource != null;
   }
   function validLinkUpdate() {
    let d = request.resource.data;
    return d.keys().hasOnly(['rev','payload','updatedAt']) &&
           d.keys().hasAll(['rev','payload','updatedAt']) &&
           d.rev is int && d.rev == resource.data.rev + 1 &&
           d.payload is string && d.payload.size() <= 300000 &&
           d.updatedAt == request.time;
   }
   allow get: if linkExists();
   allow update: if linkExists() && validLinkUpdate();
  }

 }
}
