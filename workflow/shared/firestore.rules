rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function allowed() {
   return request.auth != null &&
          request.auth.token.firebase.sign_in_provider == 'google.com' &&
          request.auth.token.email_verified == true &&
          request.auth.token.email is string &&
          exists(/databases/$(database)/documents/adminWorkflowMembers/$(request.auth.token.email));
  }
  function valid(nextRev) {
   let d = request.resource.data;
   return d.keys().hasOnly(['rev','payload','updatedAt','updatedBy']) &&
          d.rev is int && d.rev == nextRev &&
          d.payload is string && d.payload.size() <= 750000 &&
          d.updatedAt == request.time && d.updatedBy == request.auth.uid;
  }
  match /boards/administration {
   allow get: if allowed();
   allow create: if allowed() && valid(1);
   allow update: if allowed() && valid(resource.data.rev + 1);
  }
 }
}
